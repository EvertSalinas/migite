#!/usr/bin/env bash
# migite — Agentic dev workflow orchestrator
# Usage: migite "task description"
#        migite --jira PROJ-123
#
# ── About the name ────────────────────────────────────────────────────────────
# Migite (右手, みぎて) is the Japanese word for "right hand". As in right-hand
# man — the trusted assistant who handles the groundwork so you can focus on
# what matters. That's exactly what this workflow does: it plans before you
# touch a file, gates before you implement, reviews before you commit, and
# captures knowledge so nothing gets lost. It doesn't replace your judgment —
# it extends your reach, always one step ahead, always at your side.
# ──────────────────────────────────────────────────────────────────────────────
#
# This file is the entrypoint: config, arg parsing, and phase sequencing.
# The shared helpers live in lib/ (one file per concern) and the phases in
# lib/phases/, all sourced below — they share this script's variables
# (TASK_DIR, PLAN_FILE, REVIEW_FILE, ...) directly rather than passing them as
# arguments, so read a phase file alongside this one.

set -euo pipefail

# ── Config ────────────────────────────────────────────────────────────────────
# Bootstrap defaults only. The real values come from load_migite_config
# (lib/config.sh) once the repo root is known: flags > env > $MIGITE_CONFIG
# > <repo>/.migite.yml > ~/.config/migite/config.yml > defaults. `migite config`
# prints the effective result; `migite config --init` writes a starter file.
DEV_LOG_BASE="${DEV_LOG_BASE:-$HOME/dev-log}"
LOG_DIR="${LOG_DIR:-$HOME/.dev-workflow/logs}"
DATE=$(date +%Y-%m-%d)
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
MAX_HEAL_ATTEMPTS="${MAX_HEAL_ATTEMPTS:-3}"
# The checkout this script lives in (one level up from bin/), through the
# ~/.local/bin symlink, so lib/ and the Python modules are found regardless of
# where it was invoked from.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link="$(readlink "$_self")"
  if [[ "$_link" == /* ]]; then _self="$_link"; else _self="$(dirname "$_self")/$_link"; fi
done
MIGITE_HOME="$(cd "$(dirname "$_self")/.." && pwd)"
unset _self _link
# shellcheck source=../lib/common.sh
source "$MIGITE_HOME/lib/common.sh"
migite_resolve_python
# (require_python runs after `migite doctor` is dispatched: the health check
# must run even when Python is missing — that's what it's for.)
# Phase prompts ship in this repo's prompts/ directory (plan.md, implement.md,
# review.md, architecture_critic.md) — migite-plan and migite-review resolve
# their own the same way, and `prompts.dir` in .migite.yml can override any of
# them per project. They used to live in ~/.claude/commands/ and were read with
# "if exists else ''", so a fresh machine silently ran with no plan or review
# format at all. IMPLEMENT_CMD_PATH is resolved after the config is loaded.
IMPLEMENT_CMD_PATH=""

# ── Library and phases ────────────────────────────────────────────────────────
source "$MIGITE_HOME/lib/config.sh"
source "$MIGITE_HOME/lib/stack.sh"
source "$MIGITE_HOME/lib/agent.sh"
source "$MIGITE_HOME/lib/vault.sh"
source "$MIGITE_HOME/lib/intake.sh"
source "$MIGITE_HOME/lib/gate.sh"
source "$MIGITE_HOME/lib/manifest.sh"
source "$MIGITE_HOME/lib/doctor.sh"
source "$MIGITE_HOME/lib/phases/amend.sh"
source "$MIGITE_HOME/lib/phases/plan.sh"
source "$MIGITE_HOME/lib/phases/implement.sh"
source "$MIGITE_HOME/lib/phases/review.sh"
source "$MIGITE_HOME/lib/phases/deliver.sh"

# migite_usage - `migite --help`. Dispatched before Setup so it works anywhere,
# even outside a git repo or without the agent CLI installed.
migite_usage() {
  cat <<'EOF'
migite - plan, implement, review, and deliver one task, with a human gate between each step

Usage:
  migite "<task description>"       a plain-text task; you pick its type
  migite --jira <key-or-url>        a Jira ticket: it names the task, and its content is
                                    fetched for planning (see: migite-ticket --help)
  migite <intake.md>                a pre-written intake (same as --intake)
  migite --amend ["feedback"]       scope a follow-up change against a task already built
  migite doctor [--repo <path>]     read-only health check (see: migite doctor --help)
  migite migrate-vault [--dry-run]  move flat task folders into run folders
                                    (see: migite migrate-vault --help)
  migite config [options]           show, create, edit, or check the configuration
                                    (see: migite config --help)

Task options:
  --jira <key-or-url>     the Jira ticket this task is for
  --type <type>           feature | bug | refactor | spike | config
                          (default: asked; feature under --automata)
  --intake <file>         start from a pre-written intake instead of a template
  --blueprint <file>      settled architecture from migite-blueprint, given to the planner
  --audit <report.md>     generate a remediation task from a migite-audit report
  --attach <file>         fold a file into the planner's context (repeatable)
  --staged                one implement session per Scope sub-section, with a checkpoint between
  --stack <stack>         rails | generic | a stacks.<name> profile from the config
                          (default: detected from the repo)
  --resume [run.json]     continue an interrupted run from its run manifest; without a
                          file, the newest unfinished run (or the one the options above name)
  --automata              run unattended, for CI, a schedule or another agent: no prompts,
                          editor, tmux or notifications; every gate takes its automata answer
                          and the agent sessions run headless (docs/migite.md#automata)

Amend options:
  --amend ["feedback"]    the feedback inline, or typed when prompted
  --amend-file <file>     the feedback from a file
  --jira <key>            which task to amend (default: the ticket key in the branch name)

  -h, --help              show this help

The run stops at two gates: after the plan, and before the commit. Nothing is committed for you.
Running the same command again continues an interrupted run where it stopped (run.json in the
run's folder); a finished one just prints where its files are.

Exit status: 0 finished, 1 error. With --automata also 2: stopped at the commit gate
(gates.commit.policy: strict, blockers remain), and 3: finished over blockers (lenient).

Related commands, each with --help:
  migite-ticket  migite-explore  migite-blueprint  migite-audit  migite-pr-review

Docs: docs/migite.md (commands), docs/phases.md (what each phase does),
      docs/configuration.md (every setting), docs/getting-started.md (a full first run)
EOF
}

# print_run_files - where a run's documents are. After a run finishes, and when
# a finished run is invoked again.
print_run_files() {
  echo ""
  echo -e "  Scratchpad: ${CYAN}$SCRATCHPAD_DIR${RESET}"
  echo -e "    plan.md                        → planning output"
  echo -e "    pr-description.md              → ready to paste into GitHub"
  echo -e "    $RUN_SLUG/implementation.md → implementation notes"
  echo -e "    $RUN_SLUG/review.md         → review verdict"
  echo -e "  Vault index: ${CYAN}$TASK_DIR/index.md${RESET}"
  echo -e "    plan.json / review.json / usage.json / run.json → machine-readable envelopes"
  echo -e "  Vault (read-only mirror): ${CYAN}$TASK_DIR${RESET}"
  echo ""
}

case "${1:-}" in
  -h|--help|help) migite_usage; exit 0 ;;
esac

# `migite doctor [--repo <path>]` — dispatched before Setup (require_cmd, arg
# parsing) since it must run even when those would fail (no Gemfile, missing
# agent CLI or `bundle`, etc.) - that's the whole point of a health check.
if [[ "${1:-}" == "doctor" ]]; then
  shift
  run_doctor "$@"
  exit $?
fi

# `migite migrate-vault [--dry-run]` - move every vault task folder that still
# uses the flat layout into run folders (lib/vault.sh). Needs only the config,
# for vault.base: no agent CLI, and it works outside a git repo.
if [[ "${1:-}" == "migrate-vault" ]]; then
  shift
  case "${1:-}" in
    -h|--help|help) migrate_vault_usage; exit 0 ;;
  esac
  require_python
  load_migite_config "$(git rev-parse --show-toplevel 2>/dev/null || true)"
  run_migrate_vault "$@"
  exit $?
fi

# `migite config [--init | --validate]` — show/create/check the layered config.
if [[ "${1:-}" == "config" ]]; then
  shift
  run_config_command "$@"
  exit $?
fi

# ── Setup ─────────────────────────────────────────────────────────────────────
require_python
require_cmd git
# The agent CLI (claude / cursor-agent / opencode) is required after the config is
# loaded below, since agent.backend decides which one.
# `bundle` is only required for the `rails` stack — checked after detect_stack,
# once we know which stack this repo actually is.

# ── Parse args ────────────────────────────────────────────────────────────────
TASK=""
JIRA_TICKET=""
JIRA_URL=""
TASK_TYPE=""
AUDIT_FILE=""
BLUEPRINT_FILE=""
INTAKE_FILE_ARG=""
STAGED=false
AMEND_MODE=false
AMEND_FEEDBACK=""
AMEND_FEEDBACK_FILE=""
STACK_OVERRIDE=""
ATTACH_FILES=()
RESUME_REQUESTED=false
RESUME_FILE=""
BASE_BRANCH=""
# Only --automata turns unattended mode on (lib/common.sh's automata), never a
# value left in the environment.
# shellcheck disable=SC2034  # read by automata() in lib/common.sh
MIGITE_AUTOMATA=false

while [[ $# -gt 0 ]]; do
  case "${1:-}" in
    --audit)
      AUDIT_FILE="${2:-}"
      [[ -z "$AUDIT_FILE" ]] && error "Provide an audit file path after --audit"
      [[ ! -f "$AUDIT_FILE" ]] && error "Audit file not found: $AUDIT_FILE"
      AUDIT_FILE="$(resolve_path "$AUDIT_FILE")"
      log "Audit context: $AUDIT_FILE"
      shift 2
      ;;
    --blueprint)
      BLUEPRINT_FILE="${2:-}"
      [[ -z "$BLUEPRINT_FILE" ]] && error "Provide a blueprint file path after --blueprint"
      [[ ! -f "$BLUEPRINT_FILE" ]] && error "Blueprint file not found: $BLUEPRINT_FILE"
      BLUEPRINT_FILE="$(resolve_path "$BLUEPRINT_FILE")"
      log "Blueprint context: $BLUEPRINT_FILE"
      shift 2
      ;;
    --intake)
      INTAKE_FILE_ARG="${2:-}"
      [[ -z "$INTAKE_FILE_ARG" ]] && error "Provide an intake file path after --intake"
      [[ ! -f "$INTAKE_FILE_ARG" ]] && error "Intake file not found: $INTAKE_FILE_ARG"
      INTAKE_FILE_ARG="$(resolve_path "$INTAKE_FILE_ARG")"
      log "Intake file: $INTAKE_FILE_ARG"
      shift 2
      ;;
    --staged)
      STAGED=true
      shift
      ;;
    --amend)
      AMEND_MODE=true
      # Optional inline feedback — only consume $2 if it's not itself a flag
      if [[ -n "${2:-}" && "$2" != --* ]]; then
        AMEND_FEEDBACK="$2"
        shift 2
      else
        shift
      fi
      ;;
    --amend-file)
      AMEND_MODE=true
      AMEND_FEEDBACK_FILE="${2:-}"
      [[ -z "$AMEND_FEEDBACK_FILE" ]] && error "Provide a file path after --amend-file"
      [[ ! -f "$AMEND_FEEDBACK_FILE" ]] && error "Amend feedback file not found: $AMEND_FEEDBACK_FILE"
      AMEND_FEEDBACK_FILE="$(resolve_path "$AMEND_FEEDBACK_FILE")"
      shift 2
      ;;
    --jira)
      [[ -z "${2:-}" ]] && error "Provide a Jira ticket key or URL after --jira"
      # One parser for keys and browse URLs (migite/tickets.py), shared with the Python tools.
      _ticket_vars="$(ticket_cmd parse --shell "$2")" || error "Not a Jira ticket key or ticket URL: $2"
      eval "$_ticket_vars"; unset _ticket_vars
      JIRA_TICKET="$TICKET_KEY"; JIRA_URL="$TICKET_URL"
      [[ -n "$JIRA_URL" ]] && log "Extracted Jira key from URL: $JIRA_TICKET"
      TASK="$JIRA_TICKET"
      log "Jira mode: $JIRA_TICKET"
      shift 2
      ;;
    --type)
      TASK_TYPE="${2:-}"
      case "$TASK_TYPE" in
        feature|bug|refactor|spike|config) ;;
        *) error "Invalid type '$TASK_TYPE'. Use: feature | bug | refactor | spike | config" ;;
      esac
      shift 2
      ;;
    --stack)
      # Overrides auto-detection (lib/stack.sh's detect_stack) — for the
      # ambiguous/monorepo case, or to force the generic (no lint/test
      # tooling) path on a repo that would otherwise auto-detect as rails.
      STACK_OVERRIDE="${2:-}"
      [[ -z "$STACK_OVERRIDE" ]] && error "Provide a stack name after --stack"
      shift 2
      ;;
    --resume)
      # Optional run.json (or a run folder holding one); without it, discovery
      # picks the newest unfinished run (lib/manifest.sh's manifest_discover).
      RESUME_REQUESTED=true
      if [[ -n "${2:-}" && "$2" != --* && ( "$2" == *.json || -d "$2" ) ]]; then
        RESUME_FILE="$2"
        [[ -d "$RESUME_FILE" ]] && RESUME_FILE="$RESUME_FILE/run.json"
        [[ -f "$RESUME_FILE" ]] || error "Run manifest not found: $RESUME_FILE"
        RESUME_FILE="$(resolve_path "$RESUME_FILE")"
        shift 2
      else
        shift
      fi
      ;;
    --automata)
      # Unattended: every prompt takes its automata answer (lib/gate.sh), the
      # sessions run headless (lib/agent.sh run_phase_headless), and the exit
      # status says how the run ended (see --help).
      # shellcheck disable=SC2034  # read by automata() in lib/common.sh
      MIGITE_AUTOMATA=true
      shift
      ;;
    --attach)
      # Repeatable. Each file's raw content is folded into task.md (see
      # run_plan in plan.sh) so migite-plan sees it as plain prompt text —
      # its agent calls are headless, with no permission flag passed by default
      # (permissions.headless: none), so a referenced path in the intake can
      # never be opened by the model itself.
      ATTACH_ARG="${2:-}"
      [[ -z "$ATTACH_ARG" ]] && error "Provide a file path after --attach"
      [[ ! -f "$ATTACH_ARG" ]] && error "Attachment file not found: $ATTACH_ARG"
      ATTACH_ARG="$(resolve_path "$ATTACH_ARG")"
      ATTACH_FILES+=("$ATTACH_ARG")
      log "Attachment: $ATTACH_ARG"
      shift 2
      ;;
    -h|--help)
      migite_usage
      exit 0
      ;;
    --*)
      # A mistyped option (--jria) used to become the task description silently.
      error "Unknown option: $1 (see: migite --help)"
      ;;
    *)
      # An existing .md file is auto-detected as an intake, same as --intake.
      # Anything else — plain text, or a path that doesn't exist — stays a task description.
      if [[ -f "${1:-}" && "${1:-}" == *.md ]]; then
        INTAKE_FILE_ARG="$(resolve_path "$1")"
        log "Intake file (positional): $INTAKE_FILE_ARG"
      else
        TASK="${1:-}"
      fi
      shift
      ;;
  esac
done

# Audit mode: when --audit is provided without a task, auto-set a slug so dirs have a readable name
if [[ -n "$AUDIT_FILE" && -z "$TASK" && -z "$JIRA_TICKET" ]]; then
  TASK="audit-remediation"
fi

[[ "$RESUME_REQUESTED" == "true" && "$AMEND_MODE" == "true" ]] \
  && error "--resume and --amend can't be combined; resume an amend run with: migite --resume <its run.json>"

# --automata: nobody is there to write the intake or the amendment feedback in
# an editor, so the command line has to carry the task.
if automata; then
  if [[ "$AMEND_MODE" == "true" ]]; then
    [[ -n "$AMEND_FEEDBACK" || -n "$AMEND_FEEDBACK_FILE" ]] \
      || error "--automata --amend needs the feedback on the command line: --amend \"<feedback>\" or --amend-file <file>"
  elif [[ "$RESUME_REQUESTED" != "true" && -z "$TASK" && -z "$INTAKE_FILE_ARG" ]]; then
    error "--automata needs a task: a task description, --jira <key>, --intake <file>, --audit <report> or --resume"
  fi
fi

# A ticket browse URL passed as the plain task argument means --jira
if [[ -z "$JIRA_TICKET" && -n "$TASK" && "$TASK" =~ ^https?://.*/browse/ ]]; then
  if _ticket_vars="$(ticket_cmd parse --shell "$TASK" 2>/dev/null)"; then
    eval "$_ticket_vars"
    JIRA_TICKET="$TICKET_KEY"; JIRA_URL="$TICKET_URL"
    log "Extracted Jira key from URL: $JIRA_TICKET"
    TASK="$JIRA_TICKET"
  fi
  unset _ticket_vars
fi

# ── Confirm we're in a git repo ───────────────────────────────────────────────
git rev-parse --is-inside-work-tree &>/dev/null || error "Not inside a git repo"
BRANCH=$(git branch --show-current)
log "Current branch: $BRANCH"

# ── Detect repo + org ─────────────────────────────────────────────────────────
REPO_ROOT=$(git rev-parse --show-toplevel)
REPO_NAME=$(basename "$REPO_ROOT")

# git diff and other later commands assume cwd == REPO_ROOT. Anchor it here so
# migite behaves the same whether invoked from the repo root or a subdirectory
# (e.g. a monorepo's app/ dir) — otherwise git diff's repo-root-relative paths
# get re-resolved against the wrong cwd.
cd "$REPO_ROOT"

# Org is needed before the config is applied: prompts.dir / templates.dir may
# contain {org}, and IMPLEMENT_CMD_PATH is resolved right after loading.
ORG="$("$MIGITE_PYTHON" -m migite.paths detect-org --repo-root "$REPO_ROOT")"

# ── Load configuration (needs REPO_ROOT for <repo>/.migite.yml) ──────────────
load_migite_config "$REPO_ROOT"
mkdir -p "$LOG_DIR"

# ── Resume: the run manifest (lib/manifest.sh) ───────────────────────────────
# Before the ledger, the stack and the base branch: a resumed run restores all
# three, along with its arguments and branch. A finished run stops here.
MANIFEST_RESUMED=false
MANIFEST_COMPLETE=false
manifest_discover
if [[ -n "$MANIFEST_PATH" ]]; then
  manifest_restore "$MANIFEST_PATH"
  if [[ "$MANIFEST_COMPLETE" == "true" ]]; then
    echo ""
    success "This run already finished ($MANIFEST_PATH)."
    print_run_files
    echo -e "  For a follow-up change: ${CYAN}migite --amend${RESET}. To build the task again from scratch, delete that run.json."
    echo ""
    exit 0
  fi
fi
# Per-run usage ledger: one JSONL line per headless agent call, and one per model
# for each interactive session (tokens, cost, duration, model, label, kind). Written
# by the gateway (migite/gateway.py) for the Python agents, bash's agent_ask, and
# run_phase's meter_session; summarised at exit by
# print_usage_summary into <scratchpad>/usage.json. Exported so the agents
# (and the tmux wrapper scripts, which re-export it) inherit it.
MIGITE_USAGE_LEDGER="${MIGITE_USAGE_LEDGER:-$LOG_DIR/$TIMESTAMP-usage.jsonl}"
export MIGITE_USAGE_LEDGER
require_cmd "$(agent_binary)"
log "Agent: $(agent_field display_name) ($(agent_binary))"
if automata; then
  log "Automata (--automata): no prompts, every gate takes its automata answer, the agent sessions run headless"
fi
# --stack on the command line beats `stack:` in the config, which beats auto-detection.
[[ -z "$STACK_OVERRIDE" && "$(cfg stack auto)" != "auto" ]] && STACK_OVERRIDE="$(cfg stack)"
IMPLEMENT_CMD_PATH="$(prompt_path implement)"
for _prompt in plan implement review architecture_critic; do
  [[ -f "$(prompt_path "$_prompt")" ]] || error "Prompt file missing: $(prompt_path "$_prompt") — is the migite checkout intact?"
done
unset _prompt
# On the way out (success, gate abort, or error alike): print what the run
# spent, then refresh the task's index.md so it lists this run, even an aborted
# one. An error also marks run.json failed (manifest_on_exit). The exit status is
# 0, 1, or a status an automata run chose with migite_exit (2 or 3, see --help):
# any other failure, such as a command that dies under set -e with status 2, is
# reported as 1 so a caller can trust the code.
_migite_exit() {
  local rc=$?
  manifest_on_exit "$rc"
  [[ "$(cfg budget.print_summary true)" == "true" ]] && print_usage_summary
  [[ -n "${TASK_DIR:-}" ]] && write_task_index "$TASK_DIR"
  if [[ "$rc" -ne 0 && "$rc" != "${MIGITE_EXIT_STATUS:-}" ]]; then
    exit 1
  fi
  return 0
}
trap _migite_exit EXIT

# Detects the project's stack ($STACK) and sets $APP_ROOT/$APP_REL_PATH — the
# directory holding the Gemfile, which isn't always $REPO_ROOT (e.g. a
# rails-app/ subdirectory one level down). bundle exec always runs from
# $APP_ROOT via the bundle_exec/run_rubocop_check/run_rspec_check helpers,
# regardless of where migite itself was invoked from. A stacks.<name> profile
# runs its configured commands from the repo root instead.
detect_stack
if stack_is_profile; then
  log "Stack: $STACK (stacks.$STACK profile${STACK_DETECTED_BY:+, matched $STACK_DETECTED_BY}) - app dir: ${APP_REL_PATH:-.}"
else
  log "Stack: $STACK — app dir: ${APP_REL_PATH:-.}"
fi
[[ "$STACK" == "rails" ]] && require_cmd bundle

log "Repo: $ORG/$REPO_NAME"

# ── Detect base branch ────────────────────────────────────────────────────────
BASE_BRANCH="${BASE_BRANCH:-$(detect_base_branch)}"
log "Base branch: $BASE_BRANCH"

# ── Phases ────────────────────────────────────────────────────────────────────
# plan → tdd → implement → heal → review → deliver, each recorded in run.json
# (lib/manifest.sh): marked running as it begins and done once it returns. A
# phase an earlier invocation finished is skipped; one left running (a crash)
# or pending_gate (a q at its gate) runs again, re-opening its gate. run_plan
# and run_amend_mode write the run's first manifest themselves, once its
# folder exists.
if [[ "$AMEND_MODE" == "true" ]]; then
  # ── Amend mode: locate the already-implemented task, scope a delta ──────────
  if manifest_should_run plan; then
    manifest_enter plan
    run_amend_mode
    manifest_boundary plan "done"
    manifest_boundary tdd skipped
  fi
else
  if manifest_should_run plan; then
    manifest_enter plan
    run_plan
    manifest_boundary plan "done" --set-json "phases.plan.gate_attempts=$PLAN_GATE_ATTEMPTS" --set "args.task_type=${TASK_TYPE:-}"
  fi
  if manifest_should_run tdd; then
    manifest_enter tdd
    run_tdd
    if [[ "$TDD_DECIDED" == "true" ]]; then
      manifest_boundary tdd "done" --set-json "phases.tdd.decided=true"
    else
      manifest_boundary tdd skipped --set-json "phases.tdd.decided=false"
    fi
  fi
fi

if manifest_should_run implement; then
  manifest_enter implement
  run_implement
  manifest_boundary implement "done"
fi
if manifest_should_run heal; then
  manifest_enter heal
  run_auto_heal_loop
  manifest_boundary heal "done" --set-json "phases.heal.heal_attempt=$HEAL_ATTEMPT"
fi
if manifest_should_run review; then
  manifest_enter review
  run_review
  manifest_boundary review "done" --set-json "phases.review.gate_attempts=$COMMIT_GATE_ATTEMPTS"
fi
if manifest_should_run deliver; then
  manifest_enter deliver
  run_deliver
  manifest_boundary deliver "done"
fi

# ── Done ──────────────────────────────────────────────────────────────────────
echo ""
success "Workflow complete."
print_run_files
# --automata approved the commit gate over blockers (gates.commit.policy: lenient,
# or a Y in an earlier interactive invocation): the run finished, and exits 3 so
# the caller knows the code didn't pass cleanly.
if automata; then
  _blockers=$(manifest_review_blockers)
  if [[ -n "$_blockers" ]]; then
    warn "Finished over the blockers the commit gate approved (run.json phases.review.blockers):"
    printf '%s\n' "$_blockers" | sed 's/^/    - /'
    migite_exit 3
  fi
  unset _blockers
fi
