#!/usr/bin/env bash
# migite-ticket - ticket references and ticket content, from the command line.
#
# Usage:
#   migite-ticket BB-1234                      # fetch the ticket, print markdown
#   migite-ticket https://acme.atlassian.net/browse/BB-1234 --out ticket.md
#   migite-ticket fetch BB-1234 --source jira-acli
#   migite-ticket sources [BB-1234]            # which source would be used here, and why
#   migite-ticket parse <key-or-url>           # key, URL, and site as JSON
#
# The source comes from tracker.provider in .migite.yml (docs/tickets.md). The acli
# source needs Atlassian's CLI, logged in once: acli jira auth login --web

set -euo pipefail

# The checkout this script lives in (one level up from bin/), through the
# ~/.local/bin symlink, so lib/ and the Python modules are found regardless of
# where it was invoked from.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link="$(readlink "$_self")"
  if [[ "$_link" == /* ]]; then _self="$_link"; else _self="$(dirname "$_self")/$_link"; fi
done
MIGITE_HOME="$(cd "$(dirname "$_self")/.." && pwd)"
unset _self _link
# shellcheck source=../lib/common.sh
source "$MIGITE_HOME/lib/common.sh"

usage() {
  cat <<'EOF'
migite-ticket - read a Jira ticket the way migite's planner sees it

Usage:
  migite-ticket <key-or-url> [--out <file>]     fetch the ticket; markdown on stdout
  migite-ticket fetch <key-or-url> [--out <file>] [--source jira-acli|jira-agent]
  migite-ticket sources [<key-or-url>]          which source would be used here, and why
  migite-ticket parse <key-or-url> [--shell]    the key, URL, and site, as JSON or for bash

Options:
  --out <file>      write the ticket here instead of stdout (only when the fetch succeeds)
  --source <name>   use only this source, with no fallback
  --shell           parse: print TICKET_KEY= and TICKET_URL= for bash to eval
  -h, --help        show this help

Sources, from tracker.provider in .migite.yml: Atlassian's acli, logged in once with
`acli jira auth login --web`, else the agent's Atlassian MCP tools (one model call).
Exit codes: 0 fetched, 1 failed or not a ticket, 2 no source can run here.
Setup: docs/tickets.md
EOF
}

case "${1:-}" in
  ""|-h|--help|help) usage; exit 0 ;;
esac
migite_resolve_python
require_python

# The repo whose .migite.yml applies, when there is one.
repo_args=()
if REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  repo_args=(--repo-root "$REPO_ROOT")
fi

case "${1:-}" in
  parse|fetch|sources)
    exec "$MIGITE_PYTHON" -m migite.tickets ${repo_args[@]+"${repo_args[@]}"} "$@" ;;
  *)
    exec "$MIGITE_PYTHON" -m migite.tickets ${repo_args[@]+"${repo_args[@]}"} fetch "$@" ;;
esac
