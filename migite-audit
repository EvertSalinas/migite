#!/usr/bin/env bash
# migite-audit — autonomous codebase audit
#
# Usage:
#   migite-audit [--focus <area>] [--output <file>]
#
# Examples:
#   migite-audit                    # full audit, writes to vault
#   migite-audit --focus jobs       # audit only jobs layer
#   migite-audit --output ./out.md  # write to specific file

set -euo pipefail

MIGITE_PYTHON="${MIGITE_PYTHON:-$HOME/.asdf/installs/python/3.13.5/bin/python3}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
migite-audit - audit this repository for correctness, security, and performance risks

Usage:
  migite-audit [--focus <area>] [--jira <key-or-url>] [--output <file>]

Options:
  --focus <area>        only the areas whose name matches this keyword (e.g. jobs, controllers)
  --jira <key-or-url>   file the report under that ticket's vault folder
  --output <file>       write the report here instead of the vault
  -h, --help            show this help

One reviewer per area runs in parallel, then a synthesis ranks the findings. Read-only.
Default output: <vault>/<org>/<repo>/audit-<date>.md
Turn the report into a task with: migite --audit <report.md>
EOF
}

# --help works anywhere: before the git and Python checks below.
for _arg in "$@"; do
  if [[ "$_arg" == "-h" || "$_arg" == "--help" ]]; then usage; exit 0; fi
done

# ── Preflight ────────────────────────────────────────────────────────────────────
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "✘ Not inside a git repository." >&2
  exit 1
fi
REPO_ROOT=$(git rev-parse --show-toplevel)

if [[ ! -x "$MIGITE_PYTHON" ]]; then
  echo "✘ Python not found at $MIGITE_PYTHON" >&2
  echo "  Set MIGITE_PYTHON to your Python 3.11+ binary." >&2
  exit 1
fi

if ! "$MIGITE_PYTHON" -c "import langgraph" 2>/dev/null; then
  echo "✘ Python dependencies missing. Run:" >&2
  echo "  $MIGITE_PYTHON -m pip install langgraph" >&2
  exit 1
fi

# ── Run ──────────────────────────────────────────────────────────────────────────
exec "$MIGITE_PYTHON" "$SCRIPT_DIR/migite-audit.py" --repo-root "$REPO_ROOT" "$@"
