#!/usr/bin/env bash
# migite-ticket - ticket references and ticket content, from the command line.
#
# Usage:
#   migite-ticket BB-1234                      # fetch the ticket, print markdown
#   migite-ticket https://acme.atlassian.net/browse/BB-1234 --out ticket.md
#   migite-ticket fetch BB-1234 --source jira-acli
#   migite-ticket sources [BB-1234]            # which source would be used here, and why
#   migite-ticket parse <key-or-url>           # key, URL, and site as JSON
#
# The source comes from tracker.provider in .migite.yml (docs/tickets.md). The acli
# source needs Atlassian's CLI, logged in once: acli jira auth login --web

set -euo pipefail

# Same Python resolution as migite: an explicit MIGITE_PYTHON, else a python3 that
# actually runs, else the asdf fallback.
if [[ -n "${MIGITE_PYTHON:-}" ]]; then
  :
elif command -v python3 &>/dev/null && python3 --version &>/dev/null; then
  MIGITE_PYTHON="$(command -v python3)"
else
  MIGITE_PYTHON="$HOME/.asdf/installs/python/3.13.5/bin/python3"
fi
if [[ ! -x "$MIGITE_PYTHON" ]] && ! command -v "$MIGITE_PYTHON" &>/dev/null; then
  echo "✘ Python not found at $MIGITE_PYTHON. Set MIGITE_PYTHON to your Python 3.11+ binary." >&2
  exit 1
fi

# The real directory, through the ~/.local/bin symlink, so migite_ticket.py and
# trackers/ are found beside it.
_real="${BASH_SOURCE[0]}"
if ! _real="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null)"; then
  _real="${BASH_SOURCE[0]}"
  while [[ -L "$_real" ]]; do
    _link="$(readlink "$_real")"
    if [[ "$_link" == /* ]]; then _real="$_link"; else _real="$(dirname "$_real")/$_link"; fi
  done
fi
MIGITE_HOME="$(cd "$(dirname "$_real")" && pwd)"

# The repo whose .migite.yml applies, when there is one.
repo_args=()
if REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  repo_args=(--repo-root "$REPO_ROOT")
fi

case "${1:-}" in
  ""|-h|--help)
    sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  parse|fetch|sources)
    exec "$MIGITE_PYTHON" "$MIGITE_HOME/migite_ticket.py" ${repo_args[@]+"${repo_args[@]}"} "$@" ;;
  *)
    exec "$MIGITE_PYTHON" "$MIGITE_HOME/migite_ticket.py" ${repo_args[@]+"${repo_args[@]}"} fetch "$@" ;;
esac
