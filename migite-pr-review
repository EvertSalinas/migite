#!/usr/bin/env bash
# migite-pr-review — autonomous PR reviewer
#
# Usage:
#   migite-pr-review --branch <branch> [--base <branch>] [--skip-tests] [--jira <key>] [--output <file>]
#
# Examples:
#   migite-pr-review --branch feature/<jira-ticket-id>-add-pdf-export
#   migite-pr-review --branch feature/<jira-ticket-id> --jira <jira-ticket-id>
#   migite-pr-review --branch feature/<jira-ticket-id> --jira https://yourcompany.atlassian.net/browse/<jira-ticket-id>
#   migite-pr-review --branch alex/fix-n-plus-one --base develop
#   migite-pr-review --branch feature/big-refactor --skip-tests

set -euo pipefail

MIGITE_PYTHON="${MIGITE_PYTHON:-$HOME/.asdf/installs/python/3.13.5/bin/python3}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
migite-pr-review - review a branch's changes against its base, with a verdict. Read-only.

Usage:
  migite-pr-review --branch <branch> [--base <branch>] [--skip-tests]
                   [--jira <key-or-url>] [--output <file>]

Options:
  --branch <branch>     the branch to review (required)
  --base <branch>       compare against this (default: origin/HEAD, then main, master, develop)
  --skip-tests          skip rubocop and rspec
  --jira <key-or-url>   file the review under that ticket's vault folder
  --output <file>       write the review here instead of the vault
  -h, --help            show this help

Four reviewers run in parallel (correctness, security, test coverage, conventions and
migrations), then a synthesis writes the verdict.
EOF
}

# --help works anywhere: before the git and Python checks below.
for _arg in "$@"; do
  if [[ "$_arg" == "-h" || "$_arg" == "--help" ]]; then usage; exit 0; fi
done

# ── Require --branch ─────────────────────────────────────────────────────────────
if [[ "$#" -eq 0 ]] || [[ "$*" != *"--branch"* ]]; then
  echo "✘ --branch is required" >&2
  echo "" >&2
  usage >&2
  exit 1
fi

# ── Preflight ────────────────────────────────────────────────────────────────────
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "✘ Not inside a git repository." >&2
  exit 1
fi
REPO_ROOT=$(git rev-parse --show-toplevel)

if [[ ! -x "$MIGITE_PYTHON" ]]; then
  echo "✘ Python not found at $MIGITE_PYTHON" >&2
  echo "  Set MIGITE_PYTHON to your Python 3.11+ binary." >&2
  exit 1
fi

if ! "$MIGITE_PYTHON" -c "import langgraph" 2>/dev/null; then
  echo "✘ Python dependencies missing. Run:" >&2
  echo "  $MIGITE_PYTHON -m pip install langgraph" >&2
  exit 1
fi


# ── Run ──────────────────────────────────────────────────────────────────────────
exec "$MIGITE_PYTHON" "$SCRIPT_DIR/migite-pr-review.py" --repo-root "$REPO_ROOT" "$@"
